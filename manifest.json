{
  "manifest_version": 3,
  "name": "Daily Gratitude Journal & Hourly Reminders",
  "version": "2.0",
  "description": "One kind reminder every hour, plus a three-question gratitude journal for your mornings. No streaks, no pressure.",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
