{
  "manifest_version": 3,
  "name": "Daily Gratitude — Hourly Mindfulness Reminders",
  "version": "1.4",
  "description": "A gentle mindfulness reminder. One uplifting gratitude message, every hour.",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
