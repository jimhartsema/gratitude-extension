.DS_Store
.claude/settings.local.json

# Build output. Every zip here is reproducible from src/, so none of it needs
# to live in git.
releases/

# Promo and store-listing material: video, audio, print files, social banners.
# None of it is loaded by the extension and the video in particular is far too
# heavy to keep in history forever. Kept on disk, out of the repo.
marketing/video/
marketing/store/
marketing/business-card/
marketing/linkedin/

# Note the deliberate absence of a blanket *.png — src/icons and src/images
# ship with the build and must stay tracked.

# Design handoff bundles: the source zip plus full-size reference images.
# Same category as marketing/ — kept on disk, out of history. The one asset
# the site actually needs is committed as site/og.png.
Website/
